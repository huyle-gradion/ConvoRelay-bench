+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+import type { FixtureEvent } from "./fixture.ts";
+import { loadFixture } from "./fixture.ts";
+
+const standard = fileURLToPath(new URL("../../fixtures/fake/standard.jsonl", import.meta.url));
+
+function loadStandard(): FixtureEvent[] {
+  return loadFixture(readFileSync(standard, "utf8"));
+}
+
+function messageTexts(events: readonly FixtureEvent[]): string[] {
+  return events.flatMap((event) => (event.kind === "message" ? [event.text] : []));
+}
+
+describe("standard fixture", () => {
+  it("holds 7 messages and 1 reaction, direct and group", () => {
+    const events = loadStandard();
+    expect(events).toHaveLength(8);
+    expect(events.filter((e) => e.kind === "message")).toHaveLength(7);
+    expect(events.filter((e) => e.kind === "reaction")).toHaveLength(1);
+    expect(events.some((e) => e.kind === "message" && e.chat.type === "direct")).toBe(true);
+    expect(events.some((e) => e.kind === "message" && e.chat.type === "group")).toBe(true);
+  });
+
+  it.each([
+    "Your OTP is 482910",
+    "Mã xác thực Zalo: 991204",
+    "Call me at +84 909 123 456",
+    "Invoice total: 500000 VND",
+  ])("has the text %j exactly once", (text) => {
+    expect(messageTexts(loadStandard()).filter((t) => t === text)).toHaveLength(1);
+  });
+
+  it("ends with the only 40,000-character message", () => {
+    const events = loadStandard();
+    const long = events.filter((e) => e.kind === "message" && e.text.length === 40000);
+    expect(long).toHaveLength(1);
+    expect(events.at(-1)).toBe(long[0]);
+  });
+
+  it("puts the events 1,000 ms apart, starting at 0", () => {
+    expect(loadStandard().map((e) => e.at_ms)).toEqual([0, 1000, 2000, 3000, 4000, 5000, 6000, 7000]);
+  });
+
+  it("has a reaction that targets line 1, the message Hello from Customer A", () => {
+    const events = loadStandard();
+    const reaction = events.find((e) => e.kind === "reaction");
+    expect(reaction?.kind === "reaction" && reaction.target).toBe(1);
+    const target = events.find((e) => e.line === 1);
+    expect(target?.kind === "message" && target.text).toBe("Hello from Customer A");
+  });
+});
