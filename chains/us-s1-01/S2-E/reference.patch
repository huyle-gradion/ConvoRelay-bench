+import { parseArgs } from "node:util";
+import { createHandler } from "../mock-margince/handler.ts";
+import type { Command } from "./io.ts";
+
+const USAGE = "usage: chat-bridge mock-margince [--port <n>] --secret-env <VAR>\n";
+const HOST = "127.0.0.1";
+const DEFAULT_PORT = 8787;
+
+/** The port in `text` when it is a whole number from 1 to 65535. */
+function parsePort(text: string): number | undefined {
+  const port = /^[0-9]+$/.test(text) ? Number(text) : Number.NaN;
+  return port >= 1 && port <= 65535 ? port : undefined;
+}
+
+/** Serves the Mock Margince on 127.0.0.1, signed with the secret in the environment variable `--secret-env` names. */
+export const mockMargince: Command = async (args, io) => {
+  let values: { port?: string; "secret-env"?: string };
+  try {
+    ({ values } = parseArgs({
+      args: [...args],
+      options: { port: { type: "string" }, "secret-env": { type: "string" } },
+      strict: true,
+      allowPositionals: false,
+    }));
+  } catch {
+    io.stderr(USAGE);
+    return 2;
+  }
+
+  const secretEnv = values["secret-env"];
+  const port = values.port === undefined ? DEFAULT_PORT : parsePort(values.port);
+  if (secretEnv === undefined || secretEnv === "" || port === undefined) {
+    io.stderr(USAGE);
+    return 2;
+  }
+
+  const secret = io.env[secretEnv];
+  if (secret === undefined || secret === "") {
+    io.stderr(`chat-bridge: environment variable ${secretEnv} is not set or is empty\n`);
+    return 1;
+  }
+
+  try {
+    await io.listen(HOST, port, createHandler({ secret, clock: io.clock }));
+  } catch (error) {
+    io.stderr(`chat-bridge: cannot listen on ${HOST}:${port}: ${error instanceof Error ? error.message : String(error)}\n`);
+    return 1;
+  }
+  io.stdout(`listening on http://${HOST}:${port}\n`);
+  return 0;
+};
