+/** A chat the Fake Source speaks in. */
+export interface FixtureChat {
+  id: string;
+  type: "direct" | "group";
+}
+
+interface FixtureEventBase {
+  /** 1-based line of the fixture file the event was read from. */
+  line: number;
+  /** Milliseconds from the start of the replay. */
+  at_ms: number;
+  chat: FixtureChat;
+  sender: string;
+}
+
+export interface FixtureMessage extends FixtureEventBase {
+  kind: "message";
+  text: string;
+}
+
+export interface FixtureReaction extends FixtureEventBase {
+  kind: "reaction";
+  /** Line number of the message the reaction is for. */
+  target: number;
+  emoji: string;
+}
+
+export type FixtureEvent = FixtureMessage | FixtureReaction;
+
+type Fields = Record<string, unknown>;
+
+function isRecord(value: unknown): value is Fields {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function fail(line: number, problem: string): never {
+  throw new Error(`line ${line}: ${problem}`);
+}
+
+function required(line: number, fields: Fields, key: string, path: string): unknown {
+  const value = fields[key];
+  if (value === undefined) fail(line, `${path} is required`);
+  return value;
+}
+
+function nonEmptyString(line: number, fields: Fields, key: string, path: string): string {
+  const value = required(line, fields, key, path);
+  if (typeof value !== "string" || value === "") fail(line, `${path} must be a non-empty string`);
+  return value;
+}
+
+function integer(line: number, fields: Fields, key: string, min: number, what: string): number {
+  const value = required(line, fields, key, key);
+  if (typeof value !== "number" || !Number.isInteger(value) || value < min) {
+    fail(line, `${key} must be ${what}`);
+  }
+  return value;
+}
+
+function parseChat(line: number, fields: Fields): FixtureChat {
+  const chat = required(line, fields, "chat", "chat");
+  if (!isRecord(chat)) fail(line, "chat must be an object");
+  const id = required(line, chat, "id", "chat.id");
+  if (typeof id !== "string") fail(line, "chat.id must be a string");
+  const type = required(line, chat, "type", "chat.type");
+  if (type !== "direct" && type !== "group") fail(line, 'chat.type must be "direct" or "group"');
+  return { id, type };
+}
+
+/**
+ * Turns the text of a Fake Source fixture (JSON Lines, one event per line) into its events, in file
+ * order. Blank lines are skipped but still count towards line numbers. Throws an `Error` starting
+ * with `line <n>: ` for the first line that is not a valid event.
+ */
+export function loadFixture(text: string): FixtureEvent[] {
+  const events: FixtureEvent[] = [];
+  const messageLines = new Set<number>();
+  let previousAt = 0;
+
+  text.split("\n").forEach((raw, index) => {
+    if (raw.trim() === "") return;
+    const line = index + 1;
+
+    let fields: unknown;
+    try {
+      fields = JSON.parse(raw);
+    } catch {
+      fail(line, "not valid JSON");
+    }
+    if (!isRecord(fields)) fail(line, "event must be a JSON object");
+
+    const at_ms = integer(line, fields, "at_ms", 0, "a non-negative integer");
+    const kind = required(line, fields, "kind", "kind");
+    if (kind !== "message" && kind !== "reaction") fail(line, 'kind must be "message" or "reaction"');
+    const chat = parseChat(line, fields);
+    const sender = nonEmptyString(line, fields, "sender", "sender");
+
+    let event: FixtureEvent;
+    if (kind === "message") {
+      const body = required(line, fields, "text", "text");
+      if (typeof body !== "string") fail(line, "text must be a string");
+      event = { line, at_ms, kind, chat, sender, text: body };
+    } else {
+      const target = integer(line, fields, "target", 1, "a positive integer");
+      const emoji = nonEmptyString(line, fields, "emoji", "emoji");
+      if (!messageLines.has(target)) fail(line, "target must be the line number of an earlier message");
+      event = { line, at_ms, kind, chat, sender, target, emoji };
+    }
+
+    if (at_ms < previousAt) fail(line, `at_ms must not be smaller than the previous event's (${previousAt})`);
+    previousAt = at_ms;
+    if (event.kind === "message") messageLines.add(line);
+    events.push(event);
+  });
+
+  return events;
+}
