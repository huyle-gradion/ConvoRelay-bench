@@ -0,0 +1,140 @@
+import { describe, expect, it } from "vitest";
+import { loadFixture } from "./fixture.ts";
+
+const direct = { id: "customer-a", type: "direct" };
+const group = { id: "work-group", type: "group" };
+
+function row(fields: Record<string, unknown>): string {
+  return JSON.stringify(fields);
+}
+
+function message(at_ms: number, text = "hi", extra: Record<string, unknown> = {}): string {
+  return row({ at_ms, kind: "message", chat: direct, sender: "Customer A", text, ...extra });
+}
+
+function failureOf(text: string): string {
+  try {
+    loadFixture(text);
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+  throw new Error("loadFixture did not throw");
+}
+
+describe("loadFixture", () => {
+  it("returns the events in file order with their line numbers, skipping blank lines", () => {
+    const text = [
+      message(0, "Hello"),
+      "   ",
+      row({ at_ms: 500, kind: "message", chat: group, sender: "Customer B", text: "Meeting" }),
+      row({ at_ms: 900, kind: "reaction", chat: direct, sender: "Customer B", target: 1, emoji: "👍" }),
+    ].join("\n");
+    expect(loadFixture(text)).toEqual([
+      { line: 1, at_ms: 0, kind: "message", chat: direct, sender: "Customer A", text: "Hello" },
+      { line: 3, at_ms: 500, kind: "message", chat: group, sender: "Customer B", text: "Meeting" },
+      { line: 4, at_ms: 900, kind: "reaction", chat: direct, sender: "Customer B", target: 1, emoji: "👍" },
+    ]);
+  });
+
+  it("returns nothing for an empty file and accepts a trailing newline and CRLF", () => {
+    expect(loadFixture("")).toEqual([]);
+    expect(loadFixture(`${message(0)}\r\n${message(1)}\r\n`).map((e) => e.line)).toEqual([1, 2]);
+  });
+
+  it("ignores other keys and does not return them", () => {
+    const [event] = loadFixture(message(0, "hi", { note: "x", line: 99 }));
+    expect(event).toEqual({ line: 1, at_ms: 0, kind: "message", chat: direct, sender: "Customer A", text: "hi" });
+  });
+
+  it("allows an empty text", () => {
+    expect(loadFixture(message(0, ""))).toHaveLength(1);
+  });
+
+  it("fails on a line that is not valid JSON, naming the line", () => {
+    const message_ = failureOf(`${message(0)}\n\n{oops`);
+    expect(message_.startsWith("line 3: ")).toBe(true);
+    expect(message_).toContain("not valid JSON");
+  });
+
+  it("fails on a JSON value that is not an object", () => {
+    expect(failureOf("[1]").startsWith("line 1: ")).toBe(true);
+    expect(failureOf("null").startsWith("line 1: ")).toBe(true);
+  });
+
+  it.each([
+    ["at_ms missing", row({ kind: "message", chat: direct, sender: "A", text: "x" }), "at_ms"],
+    ["at_ms negative", message(-1), "at_ms"],
+    ["at_ms fractional", message(1.5), "at_ms"],
+    ["at_ms a string", message("5" as unknown as number), "at_ms"],
+    ["kind unknown", row({ at_ms: 0, kind: "edit", chat: direct, sender: "A", text: "x" }), "kind"],
+    ["chat missing", row({ at_ms: 0, kind: "message", sender: "A", text: "x" }), "chat"],
+    ["chat.id missing", row({ at_ms: 0, kind: "message", chat: { type: "direct" }, sender: "A", text: "x" }), "chat.id"],
+    ["chat.id a number", row({ at_ms: 0, kind: "message", chat: { id: 7, type: "direct" }, sender: "A", text: "x" }), "chat.id"],
+    ["chat.type unknown", row({ at_ms: 0, kind: "message", chat: { id: "c", type: "channel" }, sender: "A", text: "x" }), "chat.type"],
+    ["sender missing", row({ at_ms: 0, kind: "message", chat: direct, text: "x" }), "sender"],
+    ["sender empty", row({ at_ms: 0, kind: "message", chat: direct, sender: "", text: "x" }), "sender"],
+    ["text missing", row({ at_ms: 0, kind: "message", chat: direct, sender: "A" }), "text"],
+    ["text a number", row({ at_ms: 0, kind: "message", chat: direct, sender: "A", text: 5 }), "text"],
+  ])("fails with the line and the field when %s", (_name, bad, field) => {
+    const error = failureOf(`${message(0)}\n${bad}`);
+    expect(error.startsWith("line 2: ")).toBe(true);
+    expect(error).toContain(field);
+  });
+
+  it("uses the documented messages for the required and chat.type cases", () => {
+    expect(failureOf(`${message(0)}\n${row({ at_ms: 0, kind: "message", chat: direct, text: "x" })}`)).toBe(
+      "line 2: sender is required",
+    );
+    expect(failureOf(row({ at_ms: 0, kind: "message", chat: { id: "c", type: "x" }, sender: "A", text: "" }))).toBe(
+      'line 1: chat.type must be "direct" or "group"',
+    );
+  });
+
+  it.each([
+    ["target missing", { target: undefined, emoji: "👍" }, "target"],
+    ["target zero", { target: 0, emoji: "👍" }, "target"],
+    ["target fractional", { target: 1.5, emoji: "👍" }, "target"],
+    ["emoji missing", { target: 1 }, "emoji"],
+    ["emoji empty", { target: 1, emoji: "" }, "emoji"],
+  ])("fails on a reaction with %s", (_name, fields, field) => {
+    const reaction = row({ at_ms: 1, kind: "reaction", chat: direct, sender: "B", ...fields });
+    const error = failureOf(`${message(0)}\n${reaction}`);
+    expect(error.startsWith("line 2: ")).toBe(true);
+    expect(error).toContain(field);
+  });
+
+  it("fails when an event is earlier than the one before it, naming that event's line", () => {
+    const error = failureOf([message(0), message(2000), "", message(1999)].join("\n"));
+    expect(error.startsWith("line 4: ")).toBe(true);
+    expect(error).toContain("at_ms");
+  });
+
+  it("accepts events at the same time", () => {
+    expect(loadFixture([message(100), message(100)].join("\n"))).toHaveLength(2);
+  });
+
+  it.each([
+    ["a line that holds no event", 5],
+    ["another reaction", 2],
+    ["itself", 3],
+  ])("fails when a reaction targets %s", (_name, target) => {
+    const lines = [
+      message(0),
+      row({ at_ms: 1, kind: "reaction", chat: direct, sender: "B", target: 1, emoji: "👍" }),
+      row({ at_ms: 2, kind: "reaction", chat: direct, sender: "B", target, emoji: "👍" }),
+    ];
+    const error = failureOf(lines.join("\n"));
+    expect(error.startsWith("line 3: ")).toBe(true);
+    expect(error).toContain("target");
+  });
+
+  it("fails when a reaction targets a line that comes after it", () => {
+    const text = [row({ at_ms: 0, kind: "reaction", chat: direct, sender: "B", target: 2, emoji: "👍" }), message(0)].join("\n");
+    expect(failureOf(text).startsWith("line 1: ")).toBe(true);
+  });
+
+  it("keeps a message of 40,000 characters whole", () => {
+    const [event] = loadFixture(message(0, "x".repeat(40000)));
+    expect(event?.kind === "message" && event.text).toBe("x".repeat(40000));
+  });
+});
