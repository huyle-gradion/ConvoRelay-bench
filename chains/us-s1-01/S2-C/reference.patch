@@ -0,0 +1,38 @@
+const WINDOW_MS = 60_000;
+
+/** Requests per window allowed from one IP string, and to the endpoint as a whole (`contract/margince/signing.md`). */
+export const IP_LIMIT = 60;
+export const ENDPOINT_LIMIT = 120;
+
+export interface RateLimiter {
+  /**
+   * Counts a request that passed the route check. Returns undefined when it is allowed (it then counts
+   * toward both limits), or the `retry-after` seconds, from 1 to 60, when it is refused (nothing is counted).
+   */
+  admit(ip: string, nowMs: number): number | undefined;
+}
+
+/** Two fixed windows aligned to the clock minute; counters of an earlier window are discarded. */
+export function createRateLimiter(): RateLimiter {
+  let window = Number.NaN;
+  let endpointCount = 0;
+  const ipCounts = new Map<string, number>();
+
+  return {
+    admit(ip, nowMs) {
+      const current = Math.floor(nowMs / WINDOW_MS);
+      if (current !== window) {
+        window = current;
+        endpointCount = 0;
+        ipCounts.clear();
+      }
+      const ipCount = ipCounts.get(ip) ?? 0;
+      if (ipCount >= IP_LIMIT || endpointCount >= ENDPOINT_LIMIT) {
+        return 60 - (Math.floor(nowMs / 1000) % 60);
+      }
+      ipCounts.set(ip, ipCount + 1);
+      endpointCount += 1;
+      return undefined;
+    },
+  };
+}
