+import type { FixtureChat, FixtureEvent } from "./fixture.ts";
+
+export interface ReplayOptions {
+  /** Time multiplier: 1 is real time, 10 ten times faster, 0 never waits. Defaults to 1. */
+  speed?: number;
+  /** ISO 8601 time that `at_ms` 0 stands for. The caller checks that it is valid. */
+  baseTime: string;
+  clock: { sleep(ms: number): Promise<void> };
+}
+
+interface ReplayedBase {
+  /** `fake:<line>` of the fixture file. */
+  id: string;
+  /** ISO 8601 with milliseconds: the base time plus the event's `at_ms`. */
+  time: string;
+}
+
+/** Key order matters: it is the order the events are printed in. */
+export type ReplayedMessage = ReplayedBase & { kind: "message"; chat: FixtureChat; sender: string; text: string };
+export type ReplayedReaction = ReplayedBase & {
+  kind: "reaction";
+  chat: FixtureChat;
+  sender: string;
+  /** Id of the message reacted to. */
+  target: string;
+  emoji: string;
+};
+export type ReplayedEvent = ReplayedMessage | ReplayedReaction;
+
+function replayed(event: FixtureEvent, base: number): ReplayedEvent {
+  const id = `fake:${event.line}`;
+  const time = new Date(base + event.at_ms).toISOString();
+  if (event.kind === "message") {
+    return { id, time, kind: event.kind, chat: event.chat, sender: event.sender, text: event.text };
+  }
+  return {
+    id,
+    time,
+    kind: event.kind,
+    chat: event.chat,
+    sender: event.sender,
+    target: `fake:${event.target}`,
+    emoji: event.emoji,
+  };
+}
+
+/**
+ * Yields the fixture's events in file order, waiting on `options.clock` for the gap before each one
+ * (divided by `speed`). Nothing runs until the first `next()`; a bad speed rejects that call.
+ */
+export async function* replay(
+  events: readonly FixtureEvent[],
+  options: ReplayOptions,
+): AsyncGenerator<ReplayedEvent> {
+  const speed = options.speed ?? 1;
+  if (!Number.isFinite(speed) || speed < 0) {
+    throw new Error(`speed must be a finite number of 0 or more, got ${speed}`);
+  }
+  const base = Date.parse(options.baseTime);
+  let previous = 0;
+  for (const event of events) {
+    if (speed > 0) await options.clock.sleep((event.at_ms - previous) / speed);
+    previous = event.at_ms;
+    yield replayed(event, base);
+  }
+}
