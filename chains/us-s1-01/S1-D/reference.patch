+import { loadFixture } from "../fake/fixture.ts";
+import { replay } from "../fake/replay.ts";
+import type { Command } from "./io.ts";
+
+export const runUsage = "run --fake <file> [--speed <number>] [--base-time <iso>]";
+
+interface RunOptions {
+  file: string;
+  speed: number;
+  baseTime: string;
+}
+
+/** Reads the arguments of `run`; undefined when they are not valid. */
+function parseArgs(args: readonly string[]): RunOptions | undefined {
+  let file: string | undefined;
+  let speed = 1;
+  let baseTime = "2026-01-01T00:00:00Z";
+  for (let i = 0; i < args.length; i += 2) {
+    const flag = args[i];
+    const value = args[i + 1];
+    if (value === undefined) return undefined;
+    if (flag === "--fake") {
+      file = value;
+    } else if (flag === "--speed") {
+      speed = value.trim() === "" ? Number.NaN : Number(value);
+      if (!Number.isFinite(speed) || speed < 0) return undefined;
+    } else if (flag === "--base-time") {
+      if (Number.isNaN(Date.parse(value))) return undefined;
+      baseTime = value;
+    } else {
+      return undefined;
+    }
+  }
+  return file === undefined ? undefined : { file, speed, baseTime };
+}
+
+/** `chat-bridge run --fake <file>`: replays a Fake Source fixture, one JSON line per event on stdout. */
+export const runCommand: Command = async (args, io) => {
+  const options = parseArgs(args);
+  if (options === undefined) {
+    io.stderr(`usage: chat-bridge ${runUsage}\n`);
+    return 2;
+  }
+
+  let text: string;
+  try {
+    text = await io.readFile(options.file);
+  } catch (error) {
+    io.stderr(`chat-bridge: cannot read ${options.file}: ${error instanceof Error ? error.message : String(error)}\n`);
+    return 1;
+  }
+
+  let events;
+  try {
+    events = loadFixture(text);
+  } catch (error) {
+    io.stderr(`chat-bridge: ${options.file}: ${error instanceof Error ? error.message : String(error)}\n`);
+    return 1;
+  }
+
+  for await (const event of replay(events, { speed: options.speed, baseTime: options.baseTime, clock: io.clock })) {
+    io.stdout(`${JSON.stringify(event)}\n`);
+  }
+  return 0;
+};
