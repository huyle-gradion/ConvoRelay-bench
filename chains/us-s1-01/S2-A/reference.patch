index 0000000..24ce2bc
--- /dev/null
+++ b/chatbridge/src/margince/signature.test.ts
@@ -0,0 +1,91 @@
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+import { sign, verify, verifyReceived } from "./signature.ts";
+import type { SigningParts } from "./signature.ts";
+
+type VectorBody = string | { repeat: string; times: number };
+
+interface RawVector {
+  name: string;
+  secret: string;
+  parts: Omit<SigningParts, "body"> & { body: VectorBody };
+  signature: string;
+}
+
+interface Vector {
+  name: string;
+  secret: string;
+  parts: SigningParts;
+  signature: string;
+}
+
+// vectors.json spells a long body as {"repeat": text, "times": n}; every other body is the string itself.
+const vectorsFile = fileURLToPath(new URL("../../contract/margince/vectors.json", import.meta.url));
+const vectors: Vector[] = (JSON.parse(readFileSync(vectorsFile, "utf8")) as { vectors: RawVector[] }).vectors.map((v) => ({
+  ...v,
+  parts: { ...v.parts, body: typeof v.parts.body === "string" ? v.parts.body : v.parts.body.repeat.repeat(v.parts.body.times) },
+}));
+
+const changes: Record<keyof SigningParts, (parts: SigningParts) => SigningParts> = {
+  scope: (parts) => ({ ...parts, scope: `${parts.scope}x` }),
+  slug: (parts) => ({ ...parts, slug: `${parts.slug}x` }),
+  ref: (parts) => ({ ...parts, ref: `${parts.ref}x` }),
+  timestamp: (parts) => ({ ...parts, timestamp: parts.timestamp + 1 }),
+  nonce: (parts) => ({ ...parts, nonce: `${parts.nonce}x` }),
+  body: (parts) => ({ ...parts, body: `${parts.body} ` }),
+};
+
+describe("sign", () => {
+  it("has vectors to check", () => {
+    expect(vectors.length).toBeGreaterThan(0);
+  });
+
+  it.each(vectors)("signs vector $name as recorded", (vector) => {
+    expect(sign(vector.secret, vector.parts)).toBe(vector.signature);
+  });
+});
+
+describe("verify", () => {
+  it.each(vectors)("accepts the recorded signature of vector $name", (vector) => {
+    expect(verify(vector.secret, vector.parts, vector.signature)).toBe(true);
+  });
+
+  it.each(vectors.flatMap((vector) => Object.keys(changes).map((field) => [vector, field] as const)))(
+    "rejects vector $0.name with its $1 changed",
+    (vector, field) => {
+      const change = changes[field as keyof SigningParts];
+      expect(verify(vector.secret, change(vector.parts), vector.signature)).toBe(false);
+    },
+  );
+
+  it.each(vectors)("rejects vector $name checked with another secret", (vector) => {
+    expect(verify(`${vector.secret}x`, vector.parts, vector.signature)).toBe(false);
+  });
+
+  it.each(vectors)("returns false without throwing for a malformed signature of vector $name", (vector) => {
+    const malformed = [
+      "",
+      vector.signature.slice(0, 63),
+      `${vector.signature}0`,
+      vector.signature.toUpperCase(),
+      `sha256=${vector.signature}`,
+      "z".repeat(64),
+    ];
+    for (const signature of malformed) {
+      expect(verify(vector.secret, vector.parts, signature)).toBe(false);
+    }
+  });
+});
+
+describe("verifyReceived", () => {
+  it.each(vectors)("verifies vector $name with the timestamp as text", (vector) => {
+    const parts = { ...vector.parts, timestamp: String(vector.parts.timestamp) };
+    expect(verifyReceived(vector.secret, parts, vector.signature)).toBe(true);
+  });
+
+  it.each(vectors)("signs the timestamp text as received, so a leading zero changes vector $name", (vector) => {
+    const parts = { ...vector.parts, timestamp: `0${vector.parts.timestamp}` };
+    expect(verifyReceived(vector.secret, parts, vector.signature)).toBe(false);
+  });
+});
