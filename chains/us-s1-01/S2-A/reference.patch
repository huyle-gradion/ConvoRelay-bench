@@ -0,0 +1,40 @@
+import { createHash, createHmac, timingSafeEqual } from "node:crypto";
+
+/** What a Margince request signs. `timestamp` is Unix time in whole seconds. */
+export interface SigningParts {
+  scope: string;
+  slug: string;
+  ref: string;
+  timestamp: number;
+  nonce: string;
+  body: string;
+}
+
+/** The same parts as a receiver holds them: the timestamp is the header text exactly as sent, which is what it signs. */
+export type ReceivedParts = Omit<SigningParts, "timestamp"> & { timestamp: string };
+
+const SIGNATURE_PATTERN = /^[0-9a-f]{64}$/;
+
+function signReceived(secret: string, parts: ReceivedParts): string {
+  const bodyHash = createHash("sha256").update(parts.body, "utf8").digest("hex");
+  const canonical = [parts.scope, parts.slug, parts.ref, parts.timestamp, parts.nonce, bodyHash].join("\n");
+  return createHmac("sha256", secret).update(canonical, "utf8").digest("hex");
+}
+
+/** The 64-character lower-case hex HMAC-SHA256 of `parts`, without the `sha256=` prefix (see `contract/margince/signing.md`). */
+export function sign(secret: string, parts: SigningParts): string {
+  return signReceived(secret, { ...parts, timestamp: String(parts.timestamp) });
+}
+
+/** Whether `signature` (lower-case hex, no prefix) is the signature of `parts` as received. Never throws. */
+export function verifyReceived(secret: string, parts: ReceivedParts, signature: string): boolean {
+  if (!SIGNATURE_PATTERN.test(signature)) {
+    return false;
+  }
+  return timingSafeEqual(Buffer.from(signReceived(secret, parts), "hex"), Buffer.from(signature, "hex"));
+}
+
+/** Whether `signature` (lower-case hex, no prefix) is the signature of `parts`. Never throws. */
+export function verify(secret: string, parts: SigningParts, signature: string): boolean {
+  return verifyReceived(secret, { ...parts, timestamp: String(parts.timestamp) }, signature);
+}
