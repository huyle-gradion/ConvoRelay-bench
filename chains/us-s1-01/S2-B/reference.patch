+import type { Clock } from "../clock.ts";
+import type { HttpHandler, HttpRequest, HttpResponse } from "../http.ts";
+import { verifyReceived } from "../margince/signature.ts";
+
+const ENDPOINT = /^\/v1\/workspaces\/([a-z0-9]+(?:-[a-z0-9]+)*)\/batches$/;
+const MAX_SLUG_LENGTH = 63;
+const WINDOW_SECONDS = 300;
+const SIGNATURE_PREFIX = "sha256=";
+
+const accepted: HttpResponse = { status: 202, headers: {}, body: "" };
+
+function refusal(status: number, error: string): HttpResponse {
+  return { status, headers: { "content-type": "application/json" }, body: JSON.stringify({ error }) };
+}
+
+/** The workspace slug of a batch push, or undefined when the request is not one. */
+function routeSlug(request: HttpRequest): string | undefined {
+  if (request.method !== "POST") {
+    return undefined;
+  }
+  const slug = ENDPOINT.exec(request.path)?.[1];
+  return slug !== undefined && slug.length <= MAX_SLUG_LENGTH ? slug : undefined;
+}
+
+function insideWindow(timestamp: string, nowSeconds: number): boolean {
+  return /^[0-9]+$/.test(timestamp) && Math.abs(nowSeconds - Number(timestamp)) <= WINDOW_SECONDS;
+}
+
+/**
+ * The Mock Margince: answers a signed batch push exactly as `contract/margince/signing.md` says.
+ * Nonces live in this handler's memory only.
+ */
+export function createHandler({ secret, clock }: { secret: string; clock: Pick<Clock, "now"> }): HttpHandler {
+  /** `slug\nnonce` -> the second after which the accepted request that used it is outside its window. */
+  const nonces = new Map<string, number>();
+
+  return (request) => {
+    const slug = routeSlug(request);
+    if (slug === undefined) {
+      return refusal(404, "not_found");
+    }
+
+    const scope = request.headers["x-margince-scope"];
+    const ref = request.headers["x-margince-ref"];
+    const timestamp = request.headers["x-margince-timestamp"];
+    const nonce = request.headers["x-margince-nonce"];
+    const signature = request.headers["x-margince-signature"];
+    if (!scope || !ref || !timestamp || !nonce || !signature) {
+      return refusal(400, "missing_header");
+    }
+
+    const parts = { scope, slug, ref, timestamp, nonce, body: request.body };
+    if (!signature.startsWith(SIGNATURE_PREFIX) || !verifyReceived(secret, parts, signature.slice(SIGNATURE_PREFIX.length))) {
+      return refusal(401, "invalid_signature");
+    }
+
+    const nowSeconds = Math.floor(clock.now() / 1000);
+    if (!insideWindow(timestamp, nowSeconds)) {
+      return refusal(401, "stale_timestamp");
+    }
+
+    const key = `${slug}\n${nonce}`;
+    const expires = nonces.get(key);
+    if (expires !== undefined && nowSeconds <= expires) {
+      return refusal(409, "reused_nonce");
+    }
+
+    for (const [remembered, until] of nonces) {
+      if (nowSeconds > until) {
+        nonces.delete(remembered);
+      }
+    }
+    nonces.set(key, Number(timestamp) + WINDOW_SECONDS);
+    return accepted;
+  };
+}
