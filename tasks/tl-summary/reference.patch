diff --git c/ledger/report.go i/ledger/report.go
index e321771..5b1092a 100644
--- c/ledger/report.go
+++ i/ledger/report.go
@@ -37,3 +37,17 @@ func (l Ledger) List() string {
 	}
 	return b.String()
 }
+
+// Summary is the entry count, the income, the spending (as a positive amount) and the balance.
+func (l Ledger) Summary() string {
+	var income, spent int64
+	for _, e := range l {
+		if e.Cents > 0 {
+			income += e.Cents
+		} else {
+			spent -= e.Cents
+		}
+	}
+	return fmt.Sprintf("entries %d\nincome %s\nspent %s\nbalance %s\n",
+		len(l), FormatCents(income), FormatCents(spent), FormatCents(l.Balance()))
+}
