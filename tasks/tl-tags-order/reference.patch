+func TestTagReportIsSortedByTotalThenName(t *testing.T) {
+	t.Parallel()
+	l := Ledger{{Cents: 200, Tag: "z"}, {Cents: -500, Tag: "y"}, {Cents: -500, Tag: "x"}}
+	for i := 0; i < 20; i++ {
+		if got := l.TagReport(); got != "x -5.00\ny -5.00\nz 2.00\n" {
+			t.Fatalf("TagReport = %q", got)
+		}
+	}
+}
