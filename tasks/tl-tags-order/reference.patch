diff --git c/ledger/report.go i/ledger/report.go
index e321771..5a008c6 100644
--- c/ledger/report.go
+++ i/ledger/report.go
@@ -2,6 +2,7 @@ package ledger
 
 import (
 	"fmt"
+	"sort"
 	"strings"
 )
 
@@ -16,11 +17,23 @@ func (l Ledger) TagTotals() map[string]int64 {
 	return totals
 }
 
-// TagReport is one "tag amount" line per tag.
+// TagReport is one "tag amount" line per tag, the smallest total first and equal totals by tag name.
 func (l Ledger) TagReport() string {
+	totals := l.TagTotals()
+	tags := make([]string, 0, len(totals))
+	for tag := range totals {
+		tags = append(tags, tag)
+	}
+	sort.Slice(tags, func(i, j int) bool {
+		a, b := tags[i], tags[j]
+		if totals[a] != totals[b] {
+			return totals[a] < totals[b]
+		}
+		return a < b
+	})
 	var b strings.Builder
-	for tag, cents := range l.TagTotals() {
-		fmt.Fprintf(&b, "%s %s\n", tag, FormatCents(cents))
+	for _, tag := range tags {
+		fmt.Fprintf(&b, "%s %s\n", tag, FormatCents(totals[tag]))
 	}
 	return b.String()
 }
