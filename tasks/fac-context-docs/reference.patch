 		}
 	}
 }
+
+func TestContextDocsKeepTheirOrderAndMustStayInsideTheRepo(t *testing.T) {
+	t.Parallel()
+	p, err := profile.Parse([]byte(`{"version":3,"context_docs":["docs/b.md","docs/a.md"]}`))
+	if err != nil || len(p.ContextDocs) != 2 || p.ContextDocs[0] != "docs/b.md" {
+		t.Errorf("Parse = %v, %v; want the two docs in order", p.ContextDocs, err)
+	}
+	if _, err := profile.Parse([]byte(`{"version":3,"context_docs":["../x.md"]}`)); err == nil {
+		t.Error("Parse accepted a context doc outside the repo")
+	}
+}
