+
+func TestByTagKeepsOnlyExactMatchesInFileOrder(t *testing.T) {
+	t.Parallel()
+	l := Ledger{{Desc: "a", Tag: "food"}, {Desc: "b", Tag: "Food"}, {Desc: "c", Tag: "food"}, {Desc: "d"}}
+	got := l.ByTag("food")
+	if len(got) != 2 || got[0].Desc != "a" || got[1].Desc != "c" {
+		t.Errorf("ByTag(food) = %+v, want a and c", got)
+	}
+}
