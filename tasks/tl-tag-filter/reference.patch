 	}
 	return total
 }
+
+// ByTag is the entries tagged tag, in file order. A tag matches exactly, case included.
+func (l Ledger) ByTag(tag string) Ledger {
+	var out Ledger
+	for _, e := range l {
+		if e.Tag == tag {
+			out = append(out, e)
+		}
+	}
+	return out
+}
