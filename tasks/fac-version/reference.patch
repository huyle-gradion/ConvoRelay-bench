diff --git c/factory/internal/cli/version.go i/factory/internal/cli/version.go
new file mode 100644
index 0000000..2096fee
--- /dev/null
+++ i/factory/internal/cli/version.go
@@ -0,0 +1,21 @@
+package cli
+
+import (
+	"flag"
+	"fmt"
+)
+
+// Version is the release `t12 version` prints.
+const Version = "0.3.0-dev"
+
+func cmdVersion(e env, set *flag.FlagSet, args []string) error {
+	if err := parse(set, args); err != nil {
+		return err
+	}
+	if set.NArg() > 0 {
+		set.Usage()
+		return errUsage
+	}
+	fmt.Fprintf(e.stdout, "t12 %s\n", Version)
+	return nil
+}
diff --git c/factory/tests/unit/version_test.go i/factory/tests/unit/version_test.go
new file mode 100644
index 0000000..b732c31
--- /dev/null
+++ i/factory/tests/unit/version_test.go
@@ -0,0 +1,13 @@
+package unit
+
+import "testing"
+
+func TestVersionPrintsTheReleaseUnderBothSpellings(t *testing.T) {
+	t.Parallel()
+	for _, args := range [][]string{{"version"}, {"--version"}} {
+		code, stdout, stderr := t12(newFakeGit(""), args...)
+		if code != 0 || stdout != "t12 0.3.0-dev\n" || stderr != "" {
+			t.Errorf("t12 %v = %d %q %q, want 0 \"t12 0.3.0-dev\\n\" \"\"", args, code, stdout, stderr)
+		}
+	}
+}
